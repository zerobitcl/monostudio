# =========================================================================
# MONO STUDIO — Apache / Hostinger
# Copiar a public_html/.htaccess
# =========================================================================

# ---- HTTPS obligatorio ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar SSL
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Quitar www (canonical sin www)
  RewriteCond %{HTTP_HOST} ^www\.monostudio\.cl [NC]
  RewriteRule ^(.*)$ https://monostudio.cl/$1 [L,R=301]

  # index.html → raíz
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Bloquear archivo legacy (no indexar ni servir)
  RewriteRule ^index_vak\.html$ - [F,L]
</IfModule>

# ---- Página de error personalizada ----
ErrorDocument 404 /404.html

# ---- Compresión GZIP / Brotli ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# ---- Caché del navegador (assets estáticos) ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # HTML: revalidar siempre
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Assets: inmutable
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Seguridad
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ---- Tipos MIME ----
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType text/plain .txt
</IfModule>

# ---- Charset UTF-8 ----
AddDefaultCharset UTF-8

# ---- Proteger archivos sensibles ----
<FilesMatch "(^\.htaccess|serve\.log)$">
  Require all denied
</FilesMatch>

# ---- ETag optimizado ----
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None
